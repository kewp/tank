#endif

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////
//// 1) InGameKeystrokeUp	-	Capture presses of keys during game play (note the PAUSED and TOP_VIEW)
////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void InGameKeystrokeDown(unsigned char key, int x, int y)
{
	switch (key)
	{
		case 'w': case 'W':			{	Player1.SetKeyUp(1);	}		break;
		case 's': case 'S':			{	Player1.SetKeyDown(1);	}		break;
		case 'a': case 'A':			{	Player1.SetKeyLeft(1);	}		break;
		case 'd': case 'D':			{	Player1.SetKeyRight(1);	}		break;
		case ' ':					{	Player1.SetKeyShoot(1);	}		break;

	}
 } 
 
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////
//// 2) InGameKeystrokeUp	-	Capture release of keys during game play (note the PAUSED and TOP_VIEW)
////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void InGameKeystrokeUp(unsigned char key, int x, int y)
{
	
	switch (key)
	{
		case 'w': case 'W':		{	Player1.SetKeyUp(0);	}		break;
		case 's': case 'S':		{	Player1.SetKeyDown(0);	}		break;
		case 'a': case 'A':		{	Player1.SetKeyLeft(0);	}		break;
		case 'd': case 'D':		{	Player1.SetKeyRight(0);	}		break;
		case ' ':				{	Player1.SetKeyShoot(0);	}		break;
		
		case '0':				{	RunMode = NORMAL;		}		break;
		case '1':				{	RunMode = TOP_VIEW;		}		break;
		case 'p': case 'P':		{	RunMode = PAUSED;		}		break;
		case '+':				{	MOUSE_SENSETIVITY += 0.1; }		break;
		case '-':				{	MOUSE_SENSETIVITY -= 0.1; }		break;
	}
 } 
 
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////
//// 3) InGameMouseMove		-	Used in the game to move the tank turret
////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void InGameMouseMove(int x, int y)
{
	static int oldx,oldy;
	Player1.SetMousemove( oldx-x, oldy-y );
	oldx = x;
	oldy = y;
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////
////					4) InGameMouseButtons	-	Used for start menu only
////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void InGameMouseButtons(int Button, int State, int x, int y)
{
	if (RunMode == STARTSCREEN)
	{
		// [2026 port] The 2007 code hit-tested the difficulty buttons against hard-coded pixel
		// coordinates assuming the shipped 1450x820 window -- resize it and the buttons move out
		// from under the artwork. A browser canvas can be any size, so the same three regions are
		// now fractions of the current window. The constants are the author's original pixel
		// values divided by 1450 (x) and 820 (y), so behaviour at the original size is unchanged.
		const float w = float(glutGet(GLUT_WINDOW_WIDTH));
		const float h = float(glutGet(GLUT_WINDOW_HEIGHT));
		if ((w <= 0) || (h <= 0)) return;

		const float fx = float(x) / w;
		const float fy = float(y) / h;

		Dificulty_Level = HARD;
		if ((fy < 0.6390f) && (fy > 0.5000f))
		{
			RunMode = TRANSITION;
			if      ((fx > 0.2483f) && (fx < 0.3945f)) Dificulty_Level = EASY;
			else if ((fx > 0.3945f) && (fx < 0.5972f)) Dificulty_Level = MEDIUM;
			else if ((fx > 0.5972f) && (fx < 0.7524f)) Dificulty_Level = HARD;
			else RunMode = STARTSCREEN;
		}
	}
}